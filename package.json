{
  "name": "printninja-next",
  "private": true,
  "version": "2026.1124.0",
  "scripts": {
    "dev": "pnpm --dir app/ui dev",
    "build": "pnpm --dir app/ui build",
    "release": "node scripts/release.mjs",
    "version:set": "node scripts/set-version.mjs",
    "tauri:dev": "tauri dev --config app/tauri.conf.json",
    "tauri:build": "tauri build --config app/tauri.conf.json",
    "test:rust": "docker compose -f tests/docker-compose.test.yml run --rm rust-test",
    "test:rust:report": "docker compose -f tests/docker-compose.test.yml run --rm rust-test cargo junit --no-fail-fast -o /workspace/test-report/junit.xml",
    "test:virtual-printer": "cargo test --manifest-path tests/e2e/support/virtual-printer/Cargo.toml",
    "shots": "node scripts/screenshots.mjs",
    "shots:assets": "node scripts/refresh-assets.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.1.0",
    "esbuild": "^0.28.2"
  }
}
